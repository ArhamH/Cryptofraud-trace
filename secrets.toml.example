# Copy this file to .streamlit/secrets.toml and fill in your keys.

ETHERSCAN_API_KEY = "your_etherscan_api_key_here"

SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your_supabase_anon_or_service_key"
# Supabase Auth must have investigator accounts created manually
# (Dashboard > Authentication > Users > Add user). No public signup.

# Optional overrides — defaults work fine for light/demo use.
# MEMPOOL_BASE = "https://mempool.space/api"
# SOLANA_RPC = "https://api.mainnet-beta.solana.com"
